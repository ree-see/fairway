<%= form_with(model: [:admin, course], data: { turbo: false }) do |f| %>
  <% if course.errors.any? %>
    <div class="error-messages">
      <strong><%= pluralize(course.errors.count, "error") %> prohibited this course from being saved:</strong>
      <ul>
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <h3 style="margin-bottom: 20px; color: #667eea;">Basic Information</h3>

  <div class="form-group">
    <%= f.label :name, "Course Name *" %>
    <%= f.text_field :name, placeholder: "e.g., Pebble Beach Golf Links" %>
  </div>

  <div class="form-group">
    <%= f.label :address, "Street Address" %>
    <%= f.text_field :address, placeholder: "1700 17-Mile Drive" %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :city, "City" %>
      <%= f.text_field :city, placeholder: "Pebble Beach" %>
    </div>

    <div class="form-group">
      <%= f.label :state, "State" %>
      <%= f.text_field :state, placeholder: "CA" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :postal_code, "Zip Code" %>
      <%= f.text_field :postal_code, placeholder: "93953" %>
    </div>

    <div class="form-group">
      <%= f.label :country, "Country" %>
      <%= f.text_field :country, value: course.country || "US" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :phone, "Phone" %>
    <%= f.text_field :phone, placeholder: "(831) 625-8518" %>
  </div>

  <div class="form-group">
    <%= f.label :website, "Website" %>
    <%= f.url_field :website, placeholder: "https://www.pebblebeach.com" %>
  </div>

  <hr style="margin: 30px 0; border: none; border-top: 2px solid #f0f0f0;">

  <h3 style="margin-bottom: 20px; color: #667eea;">Location (Required)</h3>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :latitude, "Latitude *" %>
      <%= f.text_field :latitude, placeholder: "36.5675", step: "any" %>
      <div class="helper-text">
        Find coordinates: <a href="https://www.google.com/maps" target="_blank" style="color: #667eea;">Google Maps</a>
        (right-click on course → copy coordinates)
      </div>
    </div>

    <div class="form-group">
      <%= f.label :longitude, "Longitude *" %>
      <%= f.text_field :longitude, placeholder: "-121.9509", step: "any" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :geofence_radius, "Geofence Radius (meters)" %>
    <%= f.number_field :geofence_radius, value: course.geofence_radius || 500, min: 100, max: 2000 %>
    <div class="helper-text">Distance from course center to allow round registration (default: 500m)</div>
  </div>

  <hr style="margin: 30px 0; border: none; border-top: 2px solid #f0f0f0;">

  <h3 style="margin-bottom: 20px; color: #667eea;">Course Details</h3>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :par, "Par" %>
      <%= f.number_field :par, placeholder: "72", min: 54, max: 90 %>
      <div class="helper-text">Will auto-calculate from holes if left blank</div>
    </div>

    <div class="form-group">
      <%= f.label :total_yardage, "Total Yardage" %>
      <%= f.number_field :total_yardage, placeholder: "6828" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :course_rating, "Course Rating" %>
      <%= f.text_field :course_rating, placeholder: "72.8", step: "0.1" %>
      <div class="helper-text">From scorecard (e.g., 72.8)</div>
    </div>

    <div class="form-group">
      <%= f.label :slope_rating, "Slope Rating" %>
      <%= f.number_field :slope_rating, placeholder: "145", min: 55, max: 155 %>
      <div class="helper-text">From scorecard (55-155)</div>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :description, "Description" %>
    <%= f.text_area :description, placeholder: "Optional notes about the course..." %>
  </div>

  <hr style="margin: 30px 0; border: none; border-top: 2px solid #f0f0f0;">

  <h3 style="margin-bottom: 20px; color: #667eea;">Settings</h3>

  <div class="form-group">
    <label>
      <%= f.check_box :private_course %>
      Private Course
    </label>
  </div>

  <div class="form-group">
    <label>
      <%= f.check_box :active, checked: course.active.nil? ? true : course.active %>
      Active (visible to users)
    </label>
  </div>

  <div class="actions">
    <%= f.submit course.new_record? ? "Create Course" : "Update Course", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_courses_path, class: "btn btn-secondary" %>
  </div>
<% end %>
